# Cardcraft v2 — Environment Variables
#
# Copy this file to .env and fill in your Supabase credentials.
# Get them from: Supabase Dashboard → Project Settings → API

# Supabase — required for auth + cloud projects
# URL format: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon/Publishable key (safe for client-side, protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# AI secrets belong in Supabase Edge Function Secrets, NEVER in this frontend .env:
# AI_API_KEY, AI_BASE_URL, AI_MODEL, AI_REASONING_ENABLED,
# AI_ALLOWED_ORIGINS, AI_DAILY_REQUEST_LIMIT
